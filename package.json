{
  "name": "hackweek-workflow-decision-log",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs .",
    "build": "node scripts/build-static.mjs",
    "preview": "node scripts/build-static.mjs && node scripts/serve.mjs dist",
    "deploy": "npm run build && wrangler deploy",
    "legacy:dev": "vite --config legacy/vite.config.ts",
    "legacy:build": "vite build --config legacy/vite.config.ts",
    "db:create": "wrangler d1 create decision-log",
    "db:migrate": "wrangler d1 migrations apply decision-log --remote",
    "db:migrate:local": "wrangler d1 migrations apply decision-log --local"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.101.0"
  }
}
